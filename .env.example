# Copy to .env; set a strong local password. Never commit .env.
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_IMAGE=neo4j:5.26.32-community

# Explicit M0 choice: use the installed local model; no automatic switching.
EXTRACTION_PROVIDER=ollama
EXTRACTION_MODEL=qwen3.8:latest
GENERATION_PROVIDER=ollama
GENERATION_MODEL=qwen3.8:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_MODEL=gpt-6.1-terra
OPENAI_API_KEY=
OPENALEX_API_KEY=

# Zero disables paid inference. Set approval only after user authorizes a budget.
API_BUDGET_APPROVED=false
API_BUDGET_USD=0
API_MAX_REQUEST_USD=0
REQUEST_TIMEOUT_SECONDS=180
MAX_OUTPUT_TOKENS=128
MAX_CONCURRENCY=1
MAX_RETRIES=0
# Small M0 probe context; M1 must recheck room for instructions + evidence + output.
OLLAMA_CONTEXT_TOKENS=2048
GRAPH_QUERY_TIMEOUT_SECONDS=30

# Project-local downloads/caches. Private evaluation files belong outside this repo.
HF_HOME=.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=.cache/sentence-transformers
TIKTOKEN_CACHE_DIR=.cache/tiktoken
